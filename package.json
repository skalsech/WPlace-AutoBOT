{
  "name": "wplace-auto-bot",
  "version": "0.0.1",
  "type": "module",
  "keywords": [
    "tampermonkey",
    "userscript",
    "wplace",
    "automation"
  ],
  "scripts": {
    "prebuild": "npm run lint:js:fix && lint",
    "generate-languages": "node scripts/generate-languages.js",
    "build": "npm run generate-languages && node build/build.mjs",
    "build:prod": "npm run generate-languages && cross-env NODE_ENV=production node build/build.mjs",
    "dev:build": "npm run generate-languages && cross-env NODE_ENV=development node build/build.mjs",
    "dev:watch": "chokidar \"src/**/*\" -c \"npm run dev:build\"",
    "serve": "live-server --port=8000 --no-browser",
    "dev": "npm-run-all dev:build --parallel serve dev:watch",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint src/js --fix --quiet",
    "lint:js:fix": "eslint src/js --fix",
    "lint:css": "stylelint \"src/css/**/*.css\"",
    "lint:css:fix": "stylelint \"src/css/**/*.css\" --fix",
    "format": "prettier --write src/ build/",
    "format:check": "prettier --check src/ build/",
    "clean": "rimraf dist",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "coverage:clean": "rimraf coverage node_modules/.vite",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "chokidar-cli": "^3.0.0",
    "cross-env": "^10.0.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.3.0",
    "happy-dom": "^18.0.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "stylelint": "^16.23.1",
    "stylelint-config-standard": "^39.0.0",
    "vitest": "^3.2.4",
    "glob": "^11.0.3",
    "lodash": "^4.17.21"
  }
}
